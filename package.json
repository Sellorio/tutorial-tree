{
  "name": "tutorial-tree",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/docker-dev.ts",
    "tsc": "tsc -b",
    "build": "bun ./node_modules/vite/bin/vite.js build && bun ./node_modules/typescript/bin/tsc -b",
    "publish": "docker build --tag tutorial-tree:latest ./scripts && docker save --output tutorial-tree.tar tutorial-tree:latest",
    "lint": "bun --bun run oxlint",
    "test": "bun run vitest run",
    "test:watch": "bun run vitest",
    "test:coverage": "bun run vitest run --coverage",
    "test:e2e": "bun run e2e/prepare.ts && bun --bun run playwright test",
    "format": "bun --bun run prettier --write src e2e *.ts *.json *.html README.md",
    "format:check": "bun --bun run prettier --check src e2e *.ts *.json *.html README.md",
    "verify": "bun run format:check && bun run lint && bun run test:coverage && bun run build && bun --bun run playwright install chromium && bun run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.60",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svg-path-properties": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tanstack/router-plugin": "^1.168.41",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
